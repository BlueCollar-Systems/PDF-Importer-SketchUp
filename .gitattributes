# Normalize line endings: store text as LF in the repo.
# CRLF/LF churn previously caused false "drift" reports between the LF
# canonical core and CRLF checkouts. Keep repo content LF.
* text=auto eol=lf

*.rb   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.toml text eol=lf

# Binary assets - never normalize
*.png binary
*.jpg binary

# Bundled native runtime. These were relying on `text=auto` detection alone.
# Every byte is hashed into poppler-runtime-manifest.json and checked at load
# time by DependencyResolver.bundled_runtime_integrity_valid?, so any
# line-ending rewrite would silently take the whole Poppler runtime offline.
*.dll binary
# Preserve the exact pinned upstream Ghostscript notices as well as binaries.
/extracted/sketchup_ext/bc_pdf_vector_importer/Ghostscript/** -text
*.exe binary
*.pyd binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.rbz binary
*.skp binary
*.exe binary
*.dll binary
